{
  "name": "realty-catalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Демо-каталог агентства недвижимости «Литера»: фильтры, карта, карточка объекта с галереей, ипотечный калькулятор, избранное и сравнение",
  "author": "Ivan Karelin",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev --port 3004",
    "generate": "nuxt generate && node scripts/to-docs.mjs",
    "preview": "node scripts/serve-docs.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "images": "python scripts/images.py",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.3"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  }
